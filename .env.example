# ---------------------------------------------------------------------------
# Copie para .env e preencha. NUNCA comite o .env.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=sk-troque-por-sua-chave
# Modelo de raciocinio/resposta do agente
OPENAI_MODEL=gpt-4o
# Modelo de embeddings usado na base de conhecimento
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# 1536 para text-embedding-3-small, 3072 para text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# --- Banco de conhecimento (pgvector) -------------------------------------
DATABASE_URL=postgresql://fluig:fluig@localhost:5432/fluig_support
# in_memory | pgvector  (in_memory serve para rodar sem banco)
VECTOR_STORE=pgvector

# --- API REST do Fluig ----------------------------------------------------
FLUIG_BASE_URL=https://seu-fluig.empresa.com.br
# OAuth1 (padrao do Fluig)
FLUIG_CONSUMER_KEY=
FLUIG_CONSUMER_SECRET=
FLUIG_ACCESS_TOKEN=
FLUIG_TOKEN_SECRET=
FLUIG_TIMEOUT_SECONDS=30
# Bloqueia qualquer chamada que nao seja de leitura no Fluig
FLUIG_READ_ONLY=true

# --- Comportamento do agente ---------------------------------------------
AGENT_MAX_TOOL_ITERATIONS=6
RETRIEVAL_TOP_K=6
# Mascara CPF/CNPJ/e-mail/segredos antes de enviar ao LLM e aos logs
REDACT_PII=true
